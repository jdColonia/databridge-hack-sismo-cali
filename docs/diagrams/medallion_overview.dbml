// Vista general de la arquitectura medallion: las 33 tablas con sus llaves y relaciones.
// Generado por scripts/diagrams/dictionary_to_dbml.py desde docs/data_dictionary.md (commit 47c2d46).
// No editar a mano: cambia el diccionario o docs/diagrams/relaciones_logicas.json y regenera.
// Las tablas viven en workspace.<schema>: dev_<usuario> en desarrollo, default en produccion.
// Ninguna relacion es FK declarada en Unity Catalog: son linaje y cruces logicos.

Project el_equipo_medallion {
  database_type: 'Generic'
  Note: 'Databricks Free Edition, Unity Catalog y Delta. Job el_equipo_medallion: setup_volume > bronze (hackathon, IDESC, USGS, manual) > silver (referencias, edificios, microzonas, equipamientos) > gold_map_and_summaries > export_geojson.'
}

Table bronze_el_equipo_hackathon_buildings [headercolor: #B87333] {
  OBJECTID bigint [pk, note: 'Identificador único del edificio (1 a 5.146)']
  Note: 'Grano: un feature del GeoJSON (5.146 filas × 21 columnas). | Llave: OBJECTID. | Fuente: Datosprediales.json del hackathon, volumen /Volumes/<catalog>/<raw_schema>/<volume>/. | Vista resumida: 1 de 21 columnas; detalle en docs/data_dictionary.md.'
}

Table bronze_el_equipo_idesc_communes [headercolor: #B87333] {
  comcodigo string [pk, note: 'Código de la comuna']
  Note: 'Grano: Una comuna (22). | Llave: comcodigo. | Fuente: IDESC dapm:pdt_dpa_comunas. | Vista resumida: 1 de 9 columnas; detalle en docs/data_dictionary.md.'
}

Table bronze_el_equipo_idesc_neighborhoods [headercolor: #B87333] {
  barcodigo string [pk, note: 'Código del barrio, 4 dígitos']
  Note: 'Grano: Un barrio o sector DIVIPOLA (342). | Llave: barcodigo. | Fuente: IDESC dapm:pdt_dpa_barrios_sectores (Acuerdo 0636 de 2026). | Vista resumida: 1 de 13 columnas; detalle en docs/data_dictionary.md.'
}

Table bronze_el_equipo_idesc_cadastre_neighborhoods [headercolor: #B87333] {
  idbarrio string [note: 'Código comuna + barrio']
  comuna string [note: 'Código de la comuna, 2 dígitos']
  barrio string [note: 'Código del barrio, 2 dígitos']
  indexes {
    (comuna, barrio) [pk]
  }
  Note: 'Grano: Un código catastral de barrio (52). | Llave: comuna + barrio. | Fuente: IDESC catastro:cat_bas_terrenos. | Vista resumida: 3 de 6 columnas; detalle en docs/data_dictionary.md.'
}

Table bronze_el_equipo_idesc_cadastre_parcels [headercolor: #B87333] {
  id_predio bigint [note: 'Identificador del predio']
  Note: 'Grano: Un registro del catastro. | Llave: Sin llave única. | Fuente: IDESC catastro:cat_bas_terrenos, solo los predios de los edificios. | Vista resumida: 1 de 23 columnas; detalle en docs/data_dictionary.md.'
}

Table bronze_el_equipo_manual_code_catalog [headercolor: #B87333] {
  dominio string [note: 'Campo del dataset al que pertenece el código']
  codigo string [note: 'Valor del código']
  indexes {
    (dominio, codigo) [pk]
  }
  Note: 'Grano: Un código de un dominio. | Llave: dominio + codigo. | Fuente: reference/codigos_catastrales.csv (curado a mano, no es del IDESC). | Vista resumida: 2 de 8 columnas; detalle en docs/data_dictionary.md.'
}

Table bronze_el_equipo_idesc_seismic_zones [headercolor: #B87333] {
  feature_id string [pk, note: 'Identificador del feature en el WFS (zona_mzsc se repite)']
  Note: 'Grano: Un polígono de microzonificación sísmica (16 filas × 25 columnas). | Llave: feature_id (zona_mzsc se repite). | Fuente: IDESC idesc:mc_microzonificacion_sismica (WFS). Conserva las 20 propiedades originales con sus nombres originales; las medidas son double y las *_etl quedan como texto. | Vista resumida: 1 de 25 columnas; detalle en docs/data_dictionary.md.'
}

Table bronze_el_equipo_idesc_health_facilities [headercolor: #B87333] {
  feature_id string [pk, note: 'Identificador del feature en el WFS']
  Note: 'Grano: Un elemento de la capa. | Llave: feature_id. | Fuente: IDESC pot_2014:eqp_uco_salud (WFS). | Ademas: (otras propiedades): El resto de propiedades originales de la capa, con sus nombres originales, todas como texto (la lista exacta la define la capa en cada descarga) | Vista resumida: 1 de 10 columnas; detalle en docs/data_dictionary.md.'
}

Table bronze_el_equipo_idesc_security_facilities [headercolor: #B87333] {
  feature_id string [pk, note: 'Identificador del feature en el WFS']
  Note: 'Grano: Un elemento de la capa. | Llave: feature_id. | Fuente: IDESC pot_2014:eqp_uba_seguridad_ciudadana (WFS). | Ademas: (otras propiedades): El resto de propiedades originales de la capa, con sus nombres originales, todas como texto (la lista exacta la define la capa en cada descarga) | Vista resumida: 1 de 9 columnas; detalle en docs/data_dictionary.md.'
}

Table bronze_el_equipo_idesc_schools [headercolor: #B87333] {
  feature_id string [pk, note: 'Identificador del feature en el WFS']
  Note: 'Grano: Un elemento de la capa. | Llave: feature_id. | Fuente: IDESC educacion:esf_establecimiento_educativo (WFS). | Ademas: (otras propiedades): El resto de propiedades originales de la capa, con sus nombres originales, todas como texto (la lista exacta la define la capa en cada descarga) | Vista resumida: 1 de 9 columnas; detalle en docs/data_dictionary.md.'
}

Table bronze_el_equipo_idesc_public_spaces [headercolor: #B87333] {
  feature_id string [pk, note: 'Identificador del feature en el WFS']
  Note: 'Grano: Un elemento de la capa. | Llave: feature_id. | Fuente: IDESC dapm:pdt_pmep_encuentro (WFS). | Ademas: (otras propiedades): El resto de propiedades originales de la capa, con sus nombres originales, todas como texto (la lista exacta la define la capa en cada descarga) | Vista resumida: 1 de 8 columnas; detalle en docs/data_dictionary.md.'
}

Table bronze_el_equipo_usgs_earthquakes [headercolor: #B87333] {
  event_id string [pk, note: 'Identificador del evento en el USGS']
  Note: 'Grano: Un sismo (sismo principal más réplicas M ≥ 3,5 dentro del círculo oficial de la secuencia). | Llave: event_id. | Fuente: USGS, API FDSN event/1/query (evento us6000tjl2). | Vista resumida: 1 de 15 columnas; detalle en docs/data_dictionary.md.'
}

Table bronze_el_equipo_usgs_aftershock_forecast [headercolor: #B87333] {
  window_label string [note: 'Ventana: 1 Day, 1 Week, 1 Month o 1 Year']
  min_magnitude double [note: 'Magnitud mínima de la réplica (3 a 7)']
  indexes {
    (window_label, min_magnitude) [pk]
  }
  Note: 'Grano: Una combinación de ventana de tiempo y magnitud mínima del pronóstico (4 ventanas × 5 magnitudes = 20). | Llave: window_label + min_magnitude. | Fuente: USGS, producto oaf del evento us6000tjl2 (forecast.json, modelo ETAS). | Vista resumida: 2 de 13 columnas; detalle en docs/data_dictionary.md.'
}

Table bronze_el_equipo_manual_official_impact [headercolor: #B87333] {
  metric_code string [pk, note: 'Código de la métrica (deaths, injured, rescued, missing, total_collapses, collapsed_buildings)']
  Note: 'Grano: Una métrica oficial de impacto (6). | Llave: metric_code. | Fuente: reference/official_impact.csv (curado a mano: Alcaldía de Santiago de Cali, repositorio oficial, corte 16 oct 2026; la cifra de 308 edificaciones colapsadas atribuida a UNGRD/DANE queda \'por verificar\' porque no se encontró la fuente). | Vista resumida: 1 de 12 columnas; detalle en docs/data_dictionary.md.'
}

Table silver_el_equipo_communes [headercolor: #8A8D91] {
  commune_code string [pk, note: 'Código de la comuna, 2 dígitos con cero a la izquierda (ej. \'03\'). Origen: IDESC dapm:pdt_dpa_comunas, campo comcodigo.']
  Note: 'Las 22 comunas de Cali según la DIVIPOLA 2026 (Acuerdo 0636), una fila por comuna, con geometría. Fuente: IDESC. | Grano: Una comuna. | Llave: commune_code. | Fuente: IDESC dapm:pdt_dpa_comunas vía bronze_el_equipo_idesc_communes. | Notebook: src/silver/silver_references.py. | Vista resumida: 1 de 4 columnas; detalle en docs/data_dictionary.md.'
}

Table silver_el_equipo_neighborhoods [headercolor: #8A8D91] {
  neighborhood_code string [pk, note: 'Código oficial del barrio, 4 dígitos \'CCBB\' (comuna + barrio, sin guion, ej. \'1931\'). Origen: IDESC dapm:pdt_dpa_barrios_sectores, campo barcodigo.']
  commune_code string [note: 'Código de la comuna a la que pertenece el barrio, 2 dígitos. Origen: primeros 2 dígitos de neighborhood_code.']
  Note: 'Los 342 barrios y sectores oficiales de Cali (DIVIPOLA 2026, Acuerdo 0636), una fila por barrio, con su comuna y geometría. Fuente: IDESC. | Grano: Un barrio o sector oficial (342). | Llave: neighborhood_code. | Fuente: IDESC dapm:pdt_dpa_barrios_sectores (DIVIPOLA 2026) vía bronze_el_equipo_idesc_neighborhoods. | Notebook: src/silver/silver_references.py. | Vista resumida: 2 de 7 columnas; detalle en docs/data_dictionary.md.'
}

Table silver_el_equipo_cadastre_neighborhoods [headercolor: #8A8D91] {
  cadastral_neighborhood_code string [pk, note: 'Código catastral del barrio, 4 dígitos \'CCBB\' (comuna + barrio, sin guion). Origen: IDESC catastro:cat_bas_terrenos, campos comuna y barrio.']
  Note: 'Nombre que el catastro da a cada código de barrio \'CCBB\' presente en el dataset de edificios (52 códigos). Auxiliar: sirve para los códigos que la DIVIPOLA 2026 cambió u omitió. Fuente: IDESC catastro. | Grano: Un código catastral de barrio de los edificios (52). | Llave: cadastral_neighborhood_code. | Fuente: IDESC catastro:cat_bas_terrenos vía bronze_el_equipo_idesc_cadastre_neighborhoods. | Notebook: src/silver/silver_references.py. | Vista resumida: 1 de 2 columnas; detalle en docs/data_dictionary.md.'
}

Table silver_el_equipo_cadastre_parcels [headercolor: #8A8D91] {
  parcel_id bigint [note: 'Identificador del predio en el catastro. Origen: IDESC catastro:cat_bas_terrenos, campo id_predio.']
  Note: 'Registros del catastro de Cali (terrenos) que corresponden a los edificios del dataset, buscados por id_predio y por conexion. Puede haber varios registros por parcel_id o connection_code (varias unidades por terreno). Fuente: IDESC catastro. | Grano: Un registro del catastro (pueden repetirse parcel_id y connection_code). | Llave: Sin llave única. | Fuente: IDESC catastro:cat_bas_terrenos vía bronze_el_equipo_idesc_cadastre_parcels. | Notebook: src/silver/silver_references.py. | Vista resumida: 1 de 10 columnas; detalle en docs/data_dictionary.md.'
}

Table silver_el_equipo_code_catalog [headercolor: #8A8D91] {
  domain string [note: 'Campo del dataset al que pertenece el código (ej. \'TIPO_AVALU\'). Origen: reference/codigos_catastrales.csv, columna dominio.']
  code string [note: 'Valor del código tal como aparece en el dataset (ej. \'01\'). Origen: CSV, columna codigo.']
  indexes {
    (domain, code) [pk]
  }
  Note: 'Significado de los códigos catastrales del dataset (DEPAPRED, MUNIPRED, TIPO_AVALU, SECTOR, COND) con su fuente y estado de verificación. Los significados no confirmados quedan vacíos. Fuente: curada a mano (reference/codigos_catastrales.csv). | Grano: Un código de un dominio. | Llave: domain + code. | Fuente: reference/codigos_catastrales.csv vía bronze_el_equipo_manual_code_catalog. | Notebook: src/silver/silver_references.py. | Vista resumida: 2 de 6 columnas; detalle en docs/data_dictionary.md.'
}

Table silver_el_equipo_buildings [headercolor: #8A8D91] {
  building_id bigint [pk, note: 'Identificador único del edificio (1 a 5.146). Origen: bronze, OBJECTID.']
  cadastral_neighborhood_code string [note: 'Código catastral del barrio, 4 dígitos \'CCBB\' (comuna + barrio, sin guion); puede no coincidir con el oficial de 2026. Origen: bronze, COMUNA + BARRIO.']
  parcel_id bigint [note: 'Identificador del predio en el catastro; nulo si venía vacío o en 0. Origen: bronze, ID_PREDIO.']
  commune_code string [note: 'Código oficial de la comuna (2 dígitos) según la ubicación del centroide. Origen: cruce espacial con silver_el_equipo_neighborhoods (DIVIPOLA 2026).']
  neighborhood_code string [note: 'Código oficial del barrio (4 dígitos \'CCBB\') según la ubicación del centroide. Origen: cruce espacial con silver_el_equipo_neighborhoods (DIVIPOLA 2026).']
  land_use string [note: 'Uso principal del predio según el catastro (ej. \'RESIDENCIAL\'). Origen: silver_el_equipo_cadastre_parcels.']
  Note: 'Edificios de Cali afectados por el sismo del 10 de agosto, una fila por edificio (5.146). Datos del hackathon limpios, geometría en EPSG:4326 con medidas en EPSG:9377, barrio y comuna oficiales por ubicación y datos del catastro. | Grano: Un edificio (5.146). | Llave: building_id. | Fuente: bronze_el_equipo_hackathon_buildings más cruces con silver_el_equipo_neighborhoods, silver_el_equipo_cadastre_neighborhoods y silver_el_equipo_cadastre_parcels. | Notebook: src/silver/silver_buildings.py. | Vista resumida: 6 de 47 columnas; detalle en docs/data_dictionary.md.'
}

Table silver_el_equipo_neighborhood_crosswalk [headercolor: #8A8D91] {
  cadastral_neighborhood_code string [note: 'Código catastral del barrio, 4 dígitos \'CCBB\'; nulo en los edificios sin comuna o barrio en el origen. Origen: silver_el_equipo_buildings.']
  neighborhood_code string [note: 'Código oficial del barrio (4 dígitos \'CCBB\') donde cae el centroide. Origen: silver_el_equipo_buildings (DIVIPOLA 2026).']
  indexes {
    (cadastral_neighborhood_code, neighborhood_code) [pk]
  }
  Note: 'Equivalencia entre el código de barrio catastral de los edificios y el barrio oficial DIVIPOLA 2026 por ubicación, con el número de edificios de cada par. Los building_count suman los edificios con barrio oficial. | Grano: Un par código catastral → barrio oficial (54). | Llave: cadastral_neighborhood_code + neighborhood_code. | Fuente: silver_el_equipo_buildings. | Notebook: src/silver/silver_neighborhood_crosswalk.py. | Vista resumida: 2 de 6 columnas; detalle en docs/data_dictionary.md.'
}

Table silver_el_equipo_seismic_zones [headercolor: #8A8D91] {
  seismic_zone_id string [pk, note: 'Identificador del polígono (id del feature en el WFS del IDESC); es la llave, el nombre de zona se repite. Origen: bronze, feature_id.']
  Note: 'Zonas de la microzonificación sísmica de Cali, una fila por polígono (16). ETC y ETL son los dos espectros de la microzonificación sísmica (estudio INGEOMINAS–DAGMA 2005, Decreto 411.0.20.0158 de 2014); su significado exacto está por verificar en el decreto. Notación del estudio: am = aceleración máxima (g), sm = aceleración de la meseta espectral (g), t0/tc/tl = periodos (s). Un nombre de zona puede repetirse con distintos riesgos: la llave es seismic_zone_id. Origen: bronze_el_equipo_idesc_seismic_zones (IDESC, capa mc_microzonificacion_sismica). | Grano: Un polígono de microzonificación (16). | Llave: seismic_zone_id (el nombre de zona se repite). | Fuente: bronze_el_equipo_idesc_seismic_zones (IDESC idesc:mc_microzonificacion_sismica). | Notebook: src/silver/silver_seismic_zones.py. | Vista resumida: 1 de 17 columnas; detalle en docs/data_dictionary.md.'
}

Table silver_el_equipo_building_seismic_zones [headercolor: #8A8D91] {
  building_id bigint [pk, note: 'Identificador del edificio. Origen: silver_el_equipo_buildings.']
  seismic_zone_id string [note: 'Identificador de la zona elegida (mayor área de intersección; empate, el menor id); nulo si el edificio no toca ninguna zona. Origen: silver_el_equipo_seismic_zones.']
  Note: 'Zona de microzonificación sísmica de cada edificio, una fila por edificio (5.146). Se asigna la zona con mayor área de intersección con la huella (cruce en EPSG:9377); los edificios que no tocan ninguna zona quedan con nulos. ETC y ETL son los dos espectros de la microzonificación sísmica (estudio INGEOMINAS–DAGMA 2005, Decreto 411.0.20.0158 de 2014); su significado exacto está por verificar en el decreto. Origen: silver_el_equipo_buildings y silver_el_equipo_seismic_zones. | Grano: Un edificio (5.146). | Llave: building_id. | Fuente: silver_el_equipo_buildings y silver_el_equipo_seismic_zones (cruce espacial en EPSG:9377). | Notebook: src/silver/silver_seismic_zones.py. | Vista resumida: 2 de 11 columnas; detalle en docs/data_dictionary.md.'
}

Table silver_el_equipo_facilities [headercolor: #8A8D91] {
  facility_id string [pk, note: 'Identificador del equipamiento, formato \'<capa>.<id del WFS>\' (ej. \'health.eqp_uco_salud.484\'). Origen: bronze idesc, feature_id.']
  Note: 'Equipamientos de toda Cali (salud, bomberos y Defensa Civil, policía, sedes educativas y espacio público de encuentro), un equipamiento por fila. Fuente: capas oficiales del IDESC (Alcaldía de Santiago de Cali); las capas pot_2014 (salud y seguridad) no traen fecha, probablemente 2014; las sedes educativas se actualizaron en 2023–2024; el espacio público viene del PMEP 2021–2023. Pueden incluir equipamientos que ya no existen. | Grano: Un equipamiento de Cali (salud, bomberos y Defensa Civil, policía, sedes educativas y espacio público). | Llave: facility_id. | Fuente: Las cuatro bronze bronze_el_equipo_idesc_health_facilities, _idesc_security_facilities, _idesc_schools y _idesc_public_spaces. | Notebook: src/silver/silver_facilities.py. | Vista resumida: 1 de 15 columnas; detalle en docs/data_dictionary.md.'
}

Table silver_el_equipo_building_facility_distances [headercolor: #8A8D91] {
  building_id bigint [pk, note: 'Identificador del edificio. Origen: silver_el_equipo_buildings.']
  Note: 'Distancia en metros de cada edificio al equipamiento más cercano de cada tipo, una fila por edificio (5.146). Medida en EPSG:9377 desde el centroide del edificio hasta la geometría del equipamiento (0 si está dentro), con todos los equipamientos de Cali. Fuente: capas oficiales del IDESC (Alcaldía de Santiago de Cali); salud y seguridad sin fecha (probablemente 2014), colegios 2023–2024, espacio público PMEP 2021–2023. | Grano: Un edificio (5.146). | Llave: building_id. | Fuente: silver_el_equipo_buildings y silver_el_equipo_facilities. | Notebook: src/silver/silver_facilities.py. | Vista resumida: 1 de 11 columnas; detalle en docs/data_dictionary.md.'
}

Table gold_el_equipo_map_buildings [headercolor: #D4A017] {
  building_id bigint [pk, note: 'Identificador único del edificio. Origen: silver_el_equipo_buildings.']
  seismic_zone_id string [note: 'Identificador de la zona de microzonificación elegida (mayor área de intersección con la huella); nulo si el edificio no toca ninguna zona. Origen: silver_el_equipo_building_seismic_zones.']
  seismic_zone_name string [note: 'Nombre de la zona de microzonificación elegida (ej. \'Zona 4C\'); nulo si no toca ninguna. Origen: silver_el_equipo_building_seismic_zones.']
  Note: 'Vista plana para el mapa: una fila por edificio (5.146) con estado estructural, color, comuna y barrio oficiales, área, zona de microzonificación sísmica del IDESC, distancias a equipamientos del IDESC y geometría WKT. Incluye polígonos dudosos con su bandera. | Grano: Un edificio (5.146). | Llave: building_id. | Fuente: silver_el_equipo_buildings, silver_el_equipo_building_seismic_zones y silver_el_equipo_building_facility_distances (uniones por building_id). | Notebook: src/gold/gold_map_and_summaries.py. | Vista resumida: 3 de 43 columnas; detalle en docs/data_dictionary.md.'
}

Table gold_el_equipo_map_seismic_zones [headercolor: #D4A017] {
  seismic_zone_id string [pk, note: 'Identificador del polígono de microzonificación (id del feature en el WFS del IDESC). Origen: silver_el_equipo_seismic_zones.']
  Note: 'Polígonos de microzonificación sísmica del IDESC que tocan el área de los edificios (bbox de los edificios del mapa), con espectros ETC, banderas de suelo, número de edificios asignados y porcentaje de daño. Una fila por polígono; capa de contexto para el mapa. | Grano: Un polígono de microzonificación que toca el bbox de los edificios. | Llave: seismic_zone_id. | Fuente: silver_el_equipo_seismic_zones (polígonos que intersectan el bbox de los edificios, prueba con shapely) y gold_el_equipo_map_buildings (conteo y % de daño por seismic_zone_id). | Notebook: src/gold/gold_map_and_summaries.py. | Vista resumida: 1 de 11 columnas; detalle en docs/data_dictionary.md.'
}

Table gold_el_equipo_map_facilities [headercolor: #D4A017] {
  facility_id string [pk, note: 'Identificador del equipamiento, formato \'<capa>.<id del WFS>\'. Origen: silver_el_equipo_facilities.']
  Note: 'Equipamientos del IDESC dentro del área de estudio (bbox de los edificios ampliado 2.000 m): salud, bomberos y Defensa Civil, policía, colegios y espacio público de encuentro. Una fila por equipamiento; capa de contexto para el mapa. | Grano: Un equipamiento dentro del área de estudio (is_in_study_area). | Llave: facility_id. | Fuente: silver_el_equipo_facilities filtrada por is_in_study_area. | Notebook: src/gold/gold_map_and_summaries.py. | Vista resumida: 1 de 10 columnas; detalle en docs/data_dictionary.md.'
}

Table gold_el_equipo_commune_summary [headercolor: #D4A017] {
  commune_code string [pk, note: 'Código oficial de la comuna (2 dígitos). Origen: silver_el_equipo_buildings.']
  Note: 'Resumen del daño por comuna oficial: conteos y área construida por estado estructural, y porcentajes de daño y de cobertura sin datos. Una fila por comuna con edificios del dataset. | Grano: Una comuna oficial con edificios. | Llave: commune_code. | Fuente: silver_el_equipo_buildings. | Notebook: src/gold/gold_map_and_summaries.py. | Vista resumida: 1 de 16 columnas; detalle en docs/data_dictionary.md.'
}

Table gold_el_equipo_neighborhood_summary [headercolor: #D4A017] {
  neighborhood_code string [pk, note: 'Código oficial del barrio (4 dígitos \'CCBB\'). Origen: silver_el_equipo_buildings.']
  Note: 'Resumen del daño por barrio oficial (DIVIPOLA 2026): conteos y área construida por estado estructural, y porcentajes de daño y de cobertura sin datos. Una fila por barrio con edificios del dataset. | Grano: Un barrio oficial con edificios. | Llave: neighborhood_code. | Fuente: silver_el_equipo_buildings. | Notebook: src/gold/gold_map_and_summaries.py. | Vista resumida: 1 de 18 columnas; detalle en docs/data_dictionary.md.'
}

Table gold_el_equipo_seismic_zone_summary [headercolor: #D4A017] {
  seismic_zone_name string [pk, note: 'Nombre de la zona de microzonificación (ej. \'Zona 4C\'); nulo para los edificios que no tocan ninguna zona. Origen: silver_el_equipo_building_seismic_zones.']
  Note: 'Resumen del daño por zona de microzonificación sísmica (agrupado por nombre de zona, que se repite entre polígonos): conteos y área construida por estado estructural, porcentajes de daño y de cobertura sin datos, pisos promedio y medianas de distancia al hospital y al espacio público de encuentro. Una fila por zona con edificios del dataset, más una fila con zona nula si hay edificios que no tocan ninguna zona. | Grano: Una zona de microzonificación (por nombre) con edificios, más una fila con zona nula si hay edificios sin zona. | Llave: seismic_zone_name. | Fuente: gold_el_equipo_map_buildings. | Notebook: src/gold/gold_map_and_summaries.py. | Vista resumida: 1 de 23 columnas; detalle en docs/data_dictionary.md.'
}

Table gold_el_equipo_land_use_summary [headercolor: #D4A017] {
  land_use string [pk, note: 'Uso principal del predio según el catastro (ej. \'RESIDENCIAL\'); nulo agrupa los edificios sin dato de catastro. Origen: silver_el_equipo_buildings.']
  Note: 'Resumen del daño por uso del suelo del catastro del IDESC: conteos y área construida por estado estructural, y porcentajes de daño y de cobertura sin datos. Una fila por uso, más una fila con uso nulo para los edificios sin dato de catastro. | Grano: Un uso del suelo (land_use), más una fila con uso nulo para los edificios sin dato de catastro. | Llave: land_use. | Fuente: silver_el_equipo_buildings. | Notebook: src/gold/gold_map_and_summaries.py. | Vista resumida: 1 de 15 columnas; detalle en docs/data_dictionary.md.'
}

Table gold_el_equipo_event_context [headercolor: #D4A017] {
  metric_code string [note: 'Código de la cifra (ej. deaths, mainshock_magnitude, aftershock_probability_m5). Con time_window forma la llave. Origen: bronze_el_equipo_manual_official_impact y derivado de bronze_el_equipo_usgs_earthquakes y bronze_el_equipo_usgs_aftershock_forecast.']
  time_window string [note: 'Ventana de tiempo del pronóstico: 1_day, 1_week, 1_month o 1_year; nulo si la cifra no es un pronóstico. Origen: window_label de bronze_el_equipo_usgs_aftershock_forecast.']
  indexes {
    (metric_code, time_window) [pk]
  }
  Note: 'Cifras de contexto del evento listas para citar (Alcaldía y USGS), en formato largo: una fila por cifra, con unidad, ventana de tiempo, fuente, enlace, fecha de corte y estado de verificación. Las respuestas usan solo filas verified. | Grano: Una cifra de contexto del evento (formato largo). | Llave: (metric_code, time_window). | Fuente: bronze_el_equipo_manual_official_impact, bronze_el_equipo_usgs_earthquakes y bronze_el_equipo_usgs_aftershock_forecast. | Notebook: src/gold/gold_event_context.py. | Vista resumida: 2 de 9 columnas; detalle en docs/data_dictionary.md.'
}

// Relaciones: '-' uno a uno, '>' muchos a uno (logicas, no FK declaradas).
Ref: bronze_el_equipo_hackathon_buildings.OBJECTID - silver_el_equipo_buildings.building_id // limpieza 1:1 por edificio
Ref: bronze_el_equipo_idesc_communes.comcodigo - silver_el_equipo_communes.commune_code // comuna DIVIPOLA 2026
Ref: bronze_el_equipo_idesc_neighborhoods.barcodigo - silver_el_equipo_neighborhoods.neighborhood_code // barrio DIVIPOLA 2026
Ref: bronze_el_equipo_idesc_cadastre_neighborhoods.idbarrio - silver_el_equipo_cadastre_neighborhoods.cadastral_neighborhood_code // comuna + barrio catastral
Ref: bronze_el_equipo_idesc_cadastre_parcels.id_predio - silver_el_equipo_cadastre_parcels.parcel_id // registro catastral limpio
Ref: bronze_el_equipo_manual_code_catalog.codigo - silver_el_equipo_code_catalog.code // dominio + codigo
Ref: bronze_el_equipo_idesc_seismic_zones.feature_id - silver_el_equipo_seismic_zones.seismic_zone_id // poligono de microzonificacion
Ref: bronze_el_equipo_idesc_health_facilities.feature_id - silver_el_equipo_facilities.facility_id // health.<feature_id>
Ref: bronze_el_equipo_idesc_security_facilities.feature_id - silver_el_equipo_facilities.facility_id // security.<feature_id>
Ref: bronze_el_equipo_idesc_schools.feature_id - silver_el_equipo_facilities.facility_id // schools.<feature_id>
Ref: bronze_el_equipo_idesc_public_spaces.feature_id - silver_el_equipo_facilities.facility_id // public_spaces.<feature_id>
Ref: silver_el_equipo_neighborhoods.commune_code > silver_el_equipo_communes.commune_code // barrio pertenece a comuna
Ref: silver_el_equipo_buildings.commune_code > silver_el_equipo_communes.commune_code // comuna oficial por ubicacion
Ref: silver_el_equipo_buildings.neighborhood_code > silver_el_equipo_neighborhoods.neighborhood_code // barrio oficial por ubicacion (sjoin)
Ref: silver_el_equipo_buildings.cadastral_neighborhood_code > silver_el_equipo_cadastre_neighborhoods.cadastral_neighborhood_code // nombre catastral del barrio
Ref: silver_el_equipo_buildings.parcel_id > silver_el_equipo_cadastre_parcels.parcel_id // datos del catastro; parcels no tiene llave unica
Ref: silver_el_equipo_neighborhood_crosswalk.cadastral_neighborhood_code > silver_el_equipo_cadastre_neighborhoods.cadastral_neighborhood_code // codigo catastral
Ref: silver_el_equipo_neighborhood_crosswalk.neighborhood_code > silver_el_equipo_neighborhoods.neighborhood_code // barrio oficial
Ref: silver_el_equipo_building_seismic_zones.building_id - silver_el_equipo_buildings.building_id // zona de cada edificio 1:1
Ref: silver_el_equipo_building_seismic_zones.seismic_zone_id > silver_el_equipo_seismic_zones.seismic_zone_id // zona con mayor interseccion
Ref: silver_el_equipo_building_facility_distances.building_id - silver_el_equipo_buildings.building_id // distancias por edificio 1:1
Ref: gold_el_equipo_map_buildings.building_id - silver_el_equipo_buildings.building_id // una fila por edificio
Ref: gold_el_equipo_map_buildings.building_id - silver_el_equipo_building_seismic_zones.building_id // left join por building_id
Ref: gold_el_equipo_map_buildings.building_id - silver_el_equipo_building_facility_distances.building_id // left join por building_id
Ref: silver_el_equipo_buildings.commune_code > gold_el_equipo_commune_summary.commune_code // agregado por comuna
Ref: silver_el_equipo_buildings.neighborhood_code > gold_el_equipo_neighborhood_summary.neighborhood_code // agregado por barrio
Ref: gold_el_equipo_map_buildings.seismic_zone_name > gold_el_equipo_seismic_zone_summary.seismic_zone_name // agregado por nombre de zona
Ref: gold_el_equipo_map_buildings.seismic_zone_id > gold_el_equipo_map_seismic_zones.seismic_zone_id // capa de zonas del mapa
Ref: gold_el_equipo_map_seismic_zones.seismic_zone_id - silver_el_equipo_seismic_zones.seismic_zone_id // poligonos que tocan el bbox de los edificios
Ref: gold_el_equipo_map_facilities.facility_id - silver_el_equipo_facilities.facility_id // equipamientos con is_in_study_area
Ref: silver_el_equipo_buildings.land_use > gold_el_equipo_land_use_summary.land_use // agregado por uso del suelo del catastro
Ref: bronze_el_equipo_manual_official_impact.metric_code - gold_el_equipo_event_context.metric_code // cifras oficiales de la Alcaldia
Ref: bronze_el_equipo_usgs_aftershock_forecast.window_label > gold_el_equipo_event_context.time_window // probabilidad de replicas por ventana

